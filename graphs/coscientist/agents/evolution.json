{
  "name": "evolution",
  "description": "Mutates and crossbreeds top-ranked hypotheses into improved offspring",
  "inputs": [{ "kind": "Hypotheses", "port": "in" }],
  "outputs": [
    { "kind": "Hypotheses", "port": "out" }
  ],
  "config": { "temperature": 0.8, "max_iterations": 10 },
  "tools": [
    {
      "name": "search_literature",
      "description": "Search arXiv for papers matching a query. Returns title, abstract, authors, year, and arxiv_id for each result.",
      "command": ["python3", "graphs/coscientist/tools/arxiv_search.py"],
      "args_schema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query":       { "type": "string", "description": "Keywords or phrase to search for" },
          "max_results": { "type": "integer", "description": "Number of results to return (default 5, max 20)" },
          "page":        { "type": "integer", "description": "Zero-based page number for pagination (default 0)" }
        }
      },
      "timeout_secs": 30
    },
    {
      "name": "read_paper",
      "description": "Retrieve the full text of an arXiv paper as clean Markdown. Use the arxiv_id returned by arxiv_search.",
      "command": ["python3", "graphs/coscientist/tools/arxiv_search.py"],
      "args_schema": {
        "type": "object",
        "required": ["arxiv_id"],
        "properties": {
          "arxiv_id": { "type": "string", "description": "ArXiv paper ID e.g. '2404.01234' or '2404.01234v2'" }
        }
      },
      "timeout_secs": 60
    }
  ],
  "output_schema": {
    "type": "object",
    "required": ["hypotheses"],
    "properties": {
      "hypotheses": {
        "type": "array",
        "description": "Evolved offspring hypotheses",
        "items": {
          "type": "object",
          "required": ["parent_indices", "operation", "change_rationale", "rationale", "assumptions", "testable_predictions", "statement"],
          "properties": {
            "parent_indices": {
              "type": "array",
              "items": { "type": "integer" },
              "description": "Zero-based indices of parent hypotheses from the input"
            },
            "operation": {
              "type": "string",
              "enum": ["mutation", "crossover"],
              "description": "Whether this offspring was produced by mutation or crossover"
            },
            "change_rationale": {
              "type": "string",
              "description": "What was changed from the parent(s) and why"
            },
            "rationale": {
              "type": "string",
              "description": "Full mechanistic reasoning for the evolved hypothesis"
            },
            "assumptions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "testable_predictions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "statement": {
              "type": "string",
              "description": "Concise statement of the evolved hypothesis"
            },
            "proposed_experiment": { "type": "string" },
            "citations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["title", "authors", "venue", "year", "relevance"],
                "properties": {
                  "title":     { "type": "string" },
                  "authors":   { "type": "string" },
                  "venue":     { "type": "string" },
                  "year":      { "type": "integer" },
                  "doi":       { "type": "string" },
                  "relevance": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
