{
  "name": "reflection",
  "description": "Multi-axis peer review of hypotheses",
  "inputs": [{ "kind": "Hypotheses", "port": "in" }],
  "outputs": [
    { "kind": "Reviews", "port": "out" }
  ],
  "config": { "temperature": 0.3, "max_iterations": 10 },
  "tools": [
    {
      "name": "search_literature",
      "description": "Search arXiv for papers matching a query. Returns title, abstract, authors, year, and arxiv_id for each result.",
      "command": ["python3", "graphs/coscientist/tools/arxiv_search.py"],
      "args_schema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query":       { "type": "string", "description": "Keywords or phrase to search for" },
          "max_results": { "type": "integer", "description": "Number of results to return (default 5, max 20)" },
          "page":        { "type": "integer", "description": "Zero-based page number for pagination (default 0)" }
        }
      },
      "timeout_secs": 30
    },
    {
      "name": "read_paper",
      "description": "Retrieve the full text of an arXiv paper as clean Markdown. Use the arxiv_id returned by arxiv_search.",
      "command": ["python3", "graphs/coscientist/tools/arxiv_search.py"],
      "args_schema": {
        "type": "object",
        "required": ["arxiv_id"],
        "properties": {
          "arxiv_id": { "type": "string", "description": "ArXiv paper ID e.g. '2404.01234' or '2404.01234v2'" }
        }
      },
      "timeout_secs": 60
    }
  ],
  "output_schema": {
    "type": "object",
    "required": ["reviews"],
    "properties": {
      "reviews": {
        "type": "array",
        "description": "One review entry per hypothesis per dimension",
        "items": {
          "type": "object",
          "required": ["hypothesis_index", "hypothesis", "kind", "reasoning", "strengths", "weaknesses", "suggestions", "score"],
          "properties": {
            "hypothesis_index": {
              "type": "integer",
              "description": "Zero-based index of the hypothesis being reviewed"
            },
            "hypothesis": {
              "type": "object",
              "description": "The full hypothesis being reviewed (pass-through for downstream ranking)",
              "required": ["statement", "rationale", "assumptions", "testable_predictions"],
              "properties": {
                "statement":            { "type": "string" },
                "rationale":            { "type": "string" },
                "assumptions":          { "type": "array", "items": { "type": "string" } },
                "testable_predictions": { "type": "array", "items": { "type": "string" } },
                "proposed_experiment":  { "type": "string" }
              }
            },
            "kind": {
              "type": "string",
              "enum": ["Novelty", "Correctness", "Feasibility", "Safety", "Overall"],
              "description": "The review dimension"
            },
            "reasoning": {
              "type": "string",
              "description": "Detailed critique reasoning for this dimension"
            },
            "strengths": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Specific strengths identified"
            },
            "weaknesses": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Specific weaknesses identified"
            },
            "suggestions": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Concrete suggestions for improvement"
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "Numeric score for this dimension (0-10)"
            }
          }
        }
      }
    }
  }
}
