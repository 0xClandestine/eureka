{
  "name": "generation",
  "description": "Drafts novel hypotheses from a research goal",
  "inputs": [
    { "kind": "Goal",    "port": "in" },
    { "kind": "Insights","port": "context" }
  ],
  "outputs": [
    { "kind": "Hypotheses", "port": "out" }
  ],
  "config": { "temperature": 0.9, "max_iterations": 12 },
  "tools": [
    {
      "name": "search_literature",
      "description": "Search arXiv for papers matching a query. Returns title, abstract, authors, year, and arxiv_id for each result.",
      "command": ["python3", "graphs/coscientist/tools/arxiv_search.py"],
      "args_schema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query":       { "type": "string", "description": "Keywords or phrase to search for" },
          "max_results": { "type": "integer", "description": "Number of results to return (default 5, max 20)" },
          "page":        { "type": "integer", "description": "Zero-based page number for pagination (default 0)" }
        }
      },
      "timeout_secs": 30
    },
    {
      "name": "read_paper",
      "description": "Retrieve the full text of an arXiv paper as clean Markdown. Use the arxiv_id returned by arxiv_search.",
      "command": ["python3", "graphs/coscientist/tools/arxiv_search.py"],
      "args_schema": {
        "type": "object",
        "required": ["arxiv_id"],
        "properties": {
          "arxiv_id": { "type": "string", "description": "ArXiv paper ID e.g. '2404.01234' or '2404.01234v2'" }
        }
      },
      "timeout_secs": 60
    }
  ],
  "output_schema": {
    "type": "object",
    "required": ["hypotheses"],
    "properties": {
      "hypotheses": {
        "type": "array",
        "description": "Candidate hypotheses generated from the research goal",
        "items": {
          "type": "object",
          "required": ["rationale", "assumptions", "testable_predictions", "statement"],
          "properties": {
            "rationale": {
              "type": "string",
              "description": "Mechanistic or theoretical reasoning behind the hypothesis"
            },
            "assumptions": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Key assumptions underlying the hypothesis"
            },
            "testable_predictions": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Concrete, falsifiable predictions that can be experimentally verified"
            },
            "statement": {
              "type": "string",
              "description": "Concise one- or two-sentence statement of the hypothesis"
            },
            "proposed_experiment": {
              "type": "string",
              "description": "A concrete experimental design to validate this hypothesis"
            },
            "citations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["title", "authors", "venue", "year", "relevance"],
                "properties": {
                  "title":     { "type": "string" },
                  "authors":   { "type": "string" },
                  "venue":     { "type": "string" },
                  "year":      { "type": "integer" },
                  "doi":       { "type": "string" },
                  "relevance": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
