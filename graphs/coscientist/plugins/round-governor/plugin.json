{
  "name": "round-governor",
  "version": "1.0.0",
  "description": "Governs round budget. Emits a Hypotheses artifact on 'continue' if round < max_rounds, otherwise emits a Control artifact on 'halt'.",
  "runtime": "process",
  "command": ["python3", "governor.py"],
  "roles": ["node"],
  "node": {
    "inputs": [
      {"port": "in", "kind": "Hypotheses"}
    ],
    "outputs": [
      {"port": "continue", "kind": "Hypotheses"},
      {"port": "halt",     "kind": "Control"}
    ],
    "timeout_secs": 5,
    "config_schema": {
      "type": "object",
      "properties": {
        "max_rounds": {"type": "integer", "default": 12}
      }
    }
  }
}
